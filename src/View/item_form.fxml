<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.ItemFormController">
   <children>
      <AnchorPane layoutY="-2.0" prefHeight="407.0" prefWidth="600.0">
         <children>
            <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#0c0057" height="83.0" layoutX="17.0" layoutY="14.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" width="566.0" />
            <Label layoutX="207.0" layoutY="41.0" text="Enter Item Details" textAlignment="CENTER" textFill="WHITE">
               <font>
                  <Font name="Century Gothic" size="25.0" />
               </font>
            </Label>
            <TextField fx:id="itemName" layoutX="225.0" layoutY="153.0" promptText="Item Name" />
            <TextField fx:id="prize" layoutX="225.0" layoutY="248.0" promptText="Prize" />
            <TextField fx:id="quantity" layoutX="225.0" layoutY="200.0" promptText="Quantity" />
            <Button layoutX="271.0" layoutY="299.0" mnemonicParsing="false" onAction="#btnAddOnAction" prefHeight="25.0" prefWidth="57.0" style="-fx-background-color: #0c0057;" text="Add" textAlignment="CENTER" textFill="WHITE">
               <font>
                  <Font name="Berlin Sans FB" size="12.0" />
               </font>
            </Button>
            <Button layoutX="271.0" layoutY="334.0" mnemonicParsing="false" onAction="#btnViewAllOnAction" prefHeight="25.0" prefWidth="57.0" style="-fx-background-color: #0c0057;" text="View All" textAlignment="CENTER" textFill="WHITE">
               <font>
                  <Font name="Berlin Sans FB" size="12.0" />
               </font>
            </Button>
         </children> 
      </AnchorPane>
   </children>
</AnchorPane>
