<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.ViewItemFormController">
   <children>
      <AnchorPane layoutX="10.0" layoutY="9.0" prefHeight="407.0" prefWidth="600.0">
         <children>
            <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#0c0057" height="83.0" layoutX="17.0" layoutY="14.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" width="566.0" />
            <Label layoutX="191.0" layoutY="40.0" text="View Items Details" textAlignment="CENTER" textFill="WHITE">
               <font>
                  <Font name="Century Gothic" size="25.0" />
               </font>
            </Label>
            <TableView fx:id="tblItems" layoutX="15.0" layoutY="118.0" prefHeight="230.0" prefWidth="566.0">
              <columns>
                <TableColumn fx:id="colItem" prefWidth="75.0" text="Item" />
                <TableColumn fx:id="colQuantity" prefWidth="75.0" text="Quantity" />
                  <TableColumn fx:id="colPrize" prefWidth="75.0" text="Prize" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <Button layoutX="272.0" layoutY="365.0" mnemonicParsing="false" onAction="#btnReloadOnAction" style="-fx-background-color: #0c0057;" text="Reload" textFill="WHITE">
               <font>
                  <Font name="Berlin Sans FB" size="12.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
